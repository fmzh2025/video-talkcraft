  "dialogue": [
    {
      "sentence_index": 0,
      "speaker": "children",
      "speaker_label": "小孩们",
      "text": "深山白鹿，见者得富贵——获者改命数！",
      "scene_id": "1-1",
      "source_line": 6,
      "estimated_duration": 3.511,
      "planned_start": 0.0,
      "planned_end": 3.511,
      "start": 0.0,
      "end": 3.511,
      "timing_confidence": "estimated"
    },
    {
      "sentence_index": 1,
      "speaker": "villagers",
      "speaker_label": "村民",
      "text": "鹿若真在山里，早被旁人得去了。",
      "scene_id": "1-1",
      "source_line": 9,
      "estimated_duration": 3.63,
      "planned_start": 3.861,
      "planned_end": 7.491,
      "start": 3.861,
      "end": 7.491,
      "timing_confidence": "estimated"
    },
    {
      "sentence_index": 2,
      "speaker": "tycoon",
      "speaker_label": "财主",
      "text": "鹿出没的道儿，你早该报上来。",
      "scene_id": "1-1",
      "source_line": 12,
      "estimated_duration": 3.809,
      "planned_start": 7.841,
      "planned_end": 11.65,
      "start": 7.841,
      "end": 11.65,
      "timing_confidence": "estimated"
    },
    {
      "sentence_index": 3,
      "speaker": "tycoon",
      "speaker_label": "财主",
      "text": "报出路，这些，都是你的。",
      "scene_id": "1-1",
      "source_line": 15,
      "estimated_duration": 3.051,
      "planned_start": 12.0,
      "planned_end": 15.051,
      "start": 12.0,
      "end": 15.051,
      "timing_confidence": "estimated"
    },
    {
      "sentence_index": 4,
      "speaker": "aheng",
      "speaker_label": "阿衡（低声）",
      "text": "未必。",
      "scene_id": "1-1",
      "source_line": 18,
      "estimated_duration": 0.947,
      "planned_start": 15.401,
      "planned_end": 16.348,
      "start": 15.401,
      "end": 16.348,
      "timing_confidence": "estimated"
    },
    {
      "sentence_index": 5,
      "speaker": "aheng",
      "speaker_label": "阿衡",
      "text": "得鹿者，未必肯说。",
      "scene_id": "1-1",
      "source_line": 21,
      "estimated_duration": 2.713,
      "planned_start": 16.698,
      "planned_end": 19.411,
      "start": 16.698,
      "end": 19.411,
      "timing_confidence": "estimated"
    },
    {
      "sentence_index": 6,
      "speaker": "villagers",
      "speaker_label": "村民",
      "text": "追了半辈子……连个影儿都没。",
      "scene_id": "1-2",
      "source_line": 26,
      "estimated_duration": 3.45,
      "planned_start": 33.5,
      "planned_end": 36.95,
      "start": 33.5,
      "end": 36.95,
      "timing_confidence": "estimated"
    },
    {
      "sentence_index": 7,
      "speaker": "aheng",
      "speaker_label": "阿衡",
      "text": "未必。",
      "scene_id": "1-3",
      "source_line": 33,
      "estimated_duration": 0.947,
      "planned_start": 66.5,
      "planned_end": 67.447,
      "start": 66.5,
      "end": 67.447,
      "timing_confidence": "estimated"
    },
    {
      "sentence_index": 8,
      "speaker": "aheng",
      "speaker_label": "阿衡",
      "text": "得鹿的人，未必肯说……",
      "scene_id": "1-3",
      "source_line": 36,
      "estimated_duration": 3.187,
      "planned_start": 67.797,
      "planned_end": 70.984,
      "start": 67.797,
      "end": 70.984,
      "timing_confidence": "estimated"
    },
    {
      "sentence_index": 9,
      "speaker": "aheng_os",
      "speaker_label": "阿衡OS",
      "text": "可我追了半生，连一句“见过”都没挣上。",
      "scene_id": "1-3",
      "source_line": 39,
      "estimated_duration": 5.38,
      "planned_start": 71.334,
